# Copy to .env.local and fill in. .env.local is gitignored.
# On Vercel, set the same four in Project settings -> Environment Variables.

# Supabase -> Project settings -> API
# There is deliberately no NEXT_PUBLIC_SUPABASE_* variable: the browser never
# talks to Supabase in this app, so there is no anon key to ship.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The single password guarding /admin and /admin/stats. Checked server-side only.
ADMIN_PASSWORD=

# Signs the admin session cookie. Any long random string; rotating it signs
# everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
